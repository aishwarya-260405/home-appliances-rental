<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    My Rental Requests - Home Appliances Rental
  </title>

  <link
    rel="stylesheet"
    href="/style.css"
  >

  <style>

    /* ==========================================
       MAIN CONTAINER
    ========================================== */

    .requests-container {

      max-width: 1000px;

      margin: 50px auto;

      padding: 20px;

    }


    .requests-container h1 {

      text-align: center;

      color: #1e3a8a;

      margin-bottom: 30px;

    }


    /* ==========================================
       REQUEST CARD
    ========================================== */

    .request-card {

      background: white;

      border-radius: 15px;

      padding: 25px;

      margin-bottom: 20px;

      box-shadow:
        0 5px 20px
        rgba(0, 0, 0, 0.10);

    }


    .request-card h2 {

      color: #1e3a8a;

      margin-bottom: 15px;

    }


    /* ==========================================
       REQUEST DETAILS
    ========================================== */

    .request-details {

      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 10px;

      margin-bottom: 20px;

    }


    .request-details p {

      margin: 5px 0;

    }


    /* ==========================================
       STATUS
    ========================================== */

    .status {

      display: inline-block;

      padding: 7px 14px;

      border-radius: 20px;

      font-weight: bold;

      background: #e0f2fe;

      color: #0369a1;

    }


    .status-paid {

      background: #dcfce7;

      color: #166534;

    }


    .status-pending {

      background: #fef3c7;

      color: #92400e;

    }


    /* ==========================================
       TOTAL AMOUNT
    ========================================== */

    .total-amount {

      font-size: 20px;

      font-weight: bold;

      color: #2563eb;

    }


    /* ==========================================
       RENTAL DATES
    ========================================== */

    .rental-date {

      font-weight: bold;

      color: #1e3a8a;

    }


    .date-unavailable {

      color: #6b7280;

      font-weight: normal;

    }


    /* ==========================================
       DELETE BUTTON
    ========================================== */

    .delete-btn {

      padding: 10px 18px;

      background: #dc2626;

      color: white;

      border: none;

      border-radius: 7px;

      cursor: pointer;

      font-size: 14px;

    }


    .delete-btn:hover {

      background: #b91c1c;

    }


    /* ==========================================
       EMPTY MESSAGE
    ========================================== */

    .empty-message {

      text-align: center;

      background: white;

      padding: 40px;

      border-radius: 15px;

      box-shadow:
        0 5px 20px
        rgba(0, 0, 0, 0.10);

    }


    .empty-message h2 {

      color: #1e3a8a;

      margin-bottom: 10px;

    }


    /* ==========================================
       BROWSE BUTTON
    ========================================== */

    .browse-btn {

      display: inline-block;

      margin-top: 15px;

      padding: 12px 20px;

      background: #2563eb;

      color: white;

      text-decoration: none;

      border-radius: 8px;

    }


    .browse-btn:hover {

      background: #1d4ed8;

    }


    /* ==========================================
       MOBILE RESPONSIVE
    ========================================== */

    @media (max-width: 600px) {

      .request-details {

        grid-template-columns: 1fr;

      }

    }

  </style>

</head>


<body>


  <!-- ==========================================
       NAVBAR
  ========================================== -->

  <nav class="navbar">

    <div class="logo">

      Home Appliances Rental

    </div>


    <div class="nav-links">

      <a href="/">
        Home
      </a>

      <a href="/products">
        Products
      </a>

      <a href="/requests">
        My Requests
      </a>

      <a href="/logout">
        Logout
      </a>

    </div>

  </nav>


  <!-- ==========================================
       RENTAL REQUESTS
  ========================================== -->

  <div class="requests-container">


    <h1>
      My Rental Requests
    </h1>


    <% if (requests.length === 0) { %>


      <!-- ======================================
           EMPTY STATE
      ======================================= -->

      <div class="empty-message">

        <h2>
          No Rental Requests Yet
        </h2>

        <p>
          You haven't rented any appliances yet.
        </p>

        <a
          href="/products"
          class="browse-btn"
        >

          Browse Appliances

        </a>

      </div>


    <% } else { %>


      <!-- ======================================
           RENTAL REQUEST LIST
      ======================================= -->

      <% requests.forEach(request => { %>


        <div class="request-card">


          <!-- ==================================
               PRODUCT NAME
          =================================== -->

          <h2>

            <%= request.name %>

          </h2>


          <div class="request-details">


            <!-- CATEGORY -->

            <p>

              <strong>
                Category:
              </strong>

              <%= request.category %>

            </p>


            <!-- MONTHLY PRICE -->

            <p>

              <strong>
                Monthly Price:
              </strong>

              ₹<%= request.price.toLocaleString("en-IN") %>

            </p>


            <!-- RENTAL DURATION -->

            <p>

              <strong>
                Rental Duration:
              </strong>

              <%= request.rental_months %>

              Month<%= request.rental_months > 1
                ? "s"
                : ""
              %>

            </p>


            <!-- TOTAL AMOUNT -->

            <p>

              <strong>
                Total Amount:
              </strong>

              <span class="total-amount">

                ₹<%= request.total_amount.toLocaleString("en-IN") %>

              </span>

            </p>


            <!-- ==================================
                 RENTAL START DATE
            =================================== -->

            <p>

              <strong>
                Rental Start Date:
              </strong>


              <% if (request.rental_start_date) { %>

                <span class="rental-date">

                  <%= request.rental_start_date %>

                </span>

              <% } else { %>

                <span class="date-unavailable">

                  Not available

                </span>

              <% } %>

            </p>


            <!-- ==================================
                 RENTAL END DATE
            =================================== -->

            <p>

              <strong>
                Rental End Date:
              </strong>


              <% if (request.rental_end_date) { %>

                <span class="rental-date">

                  <%= request.rental_end_date %>

                </span>

              <% } else { %>

                <span class="date-unavailable">

                  Not available

                </span>

              <% } %>

            </p>


            <!-- REQUEST DATE -->

            <p>

              <strong>
                Request Date:
              </strong>

              <%= request.request_date %>

            </p>


            <!-- STATUS -->

            <p>

              <strong>
                Status:
              </strong>


              <% if (request.status === "Paid") { %>

                <span
                  class="status status-paid"
                >

                  Paid ✓

                </span>


              <% } else if (
                request.status === "Payment Pending"
              ) { %>

                <span
                  class="status status-pending"
                >

                  Payment Pending

                </span>


              <% } else { %>

                <span class="status">

                  <%= request.status %>

                </span>

              <% } %>


            </p>


          </div>


          <!-- ==================================
               DELETE REQUEST
          =================================== -->

          <form
            action="/requests/delete"
            method="POST"

            onsubmit="
              return confirm(
                'Are you sure you want to delete this rental request?'
              );
            "
          >

            <input
              type="hidden"
              name="id"
              value="<%= request.id %>"
            >


            <button
              type="submit"
              class="delete-btn"
            >

              Delete Request

            </button>

          </form>


        </div>


      <% }) %>


    <% } %>


  </div>


</body>

</html>