<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= product.name %> - Home Appliances Rental
  </title>

  <link
    rel="stylesheet"
    href="/style.css"
  >


  <style>

    /* ==========================================
       MAIN CONTAINER
    ========================================== */

    .product-details-container {

      max-width: 1050px;

      margin: 55px auto;

      padding: 20px;

    }


    /* ==========================================
       PRODUCT CARD
    ========================================== */

    .product-details-card {

      background: white;

      border-radius: 20px;

      padding: 35px;

      box-shadow:
        0 8px 30px
        rgba(0, 0, 0, 0.12);

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 45px;

      align-items: center;

    }


    /* ==========================================
       PRODUCT IMAGE
    ========================================== */

    .product-details-image {

      width: 100%;

      height: 420px;

      object-fit: cover;

      border-radius: 15px;

      display: block;

    }


    /* ==========================================
       PRODUCT INFORMATION
    ========================================== */

    .product-details-info {

      padding: 10px;

    }


    .product-details-info h1 {

      color: #1e3a8a;

      font-size: 34px;

      margin-bottom: 12px;

    }


    .category-badge {

      display: inline-block;

      padding: 7px 14px;

      background: #dbeafe;

      color: #1e40af;

      border-radius: 20px;

      font-weight: bold;

      font-size: 14px;

      margin-bottom: 20px;

    }


    /* ==========================================
       PRICE
    ========================================== */

    .product-details-price {

      font-size: 30px;

      font-weight: bold;

      color: #2563eb;

      margin-bottom: 25px;

    }


    .per-month {

      font-size: 16px;

      font-weight: normal;

      color: #6b7280;

    }


    /* ==========================================
       DESCRIPTION
    ========================================== */

    .product-description {

      color: #555;

      line-height: 1.7;

      margin-bottom: 25px;

    }


    /* ==========================================
       FEATURES
    ========================================== */

    .features-box {

      background: #f1f5ff;

      border-radius: 12px;

      padding: 20px;

      margin-bottom: 25px;

    }


    .features-box h3 {

      color: #1e3a8a;

      margin-bottom: 12px;

    }


    .feature {

      margin: 9px 0;

      color: #374151;

    }


    .feature span {

      color: #16a34a;

      font-weight: bold;

      margin-right: 7px;

    }


    /* ==========================================
       RENT BUTTON
    ========================================== */

    .rent-button {

      display: block;

      width: 100%;

      padding: 15px;

      background: #2563eb;

      color: white;

      text-decoration: none;

      text-align: center;

      border-radius: 9px;

      font-size: 17px;

      font-weight: bold;

      transition:
        background 0.2s ease;

      box-sizing: border-box;

    }


    .rent-button:hover {

      background: #1d4ed8;

    }


    /* ==========================================
       LOGIN BUTTON
    ========================================== */

    .login-button {

      display: block;

      width: 100%;

      padding: 15px;

      background: #2563eb;

      color: white;

      text-decoration: none;

      text-align: center;

      border-radius: 9px;

      font-size: 17px;

      font-weight: bold;

      box-sizing: border-box;

    }


    .login-button:hover {

      background: #1d4ed8;

    }


    /* ==========================================
       BACK LINK
    ========================================== */

    .back-link {

      display: inline-block;

      margin-top: 20px;

      color: #2563eb;

      text-decoration: none;

      font-weight: bold;

    }


    .back-link:hover {

      text-decoration: underline;

    }


    /* ==========================================
       SECURE RENTAL NOTE
    ========================================== */

    .secure-note {

      margin-top: 15px;

      text-align: center;

      color: #6b7280;

      font-size: 13px;

    }


    /* ==========================================
       RESPONSIVE
    ========================================== */

    @media (max-width: 800px) {

      .product-details-card {

        grid-template-columns: 1fr;

        gap: 25px;

        padding: 25px;

      }


      .product-details-image {

        height: 300px;

      }


      .product-details-info h1 {

        font-size: 28px;

      }

    }


    @media (max-width: 500px) {

      .product-details-container {

        margin: 25px auto;

      }


      .product-details-card {

        padding: 18px;

      }


      .product-details-image {

        height: 240px;

      }


      .product-details-price {

        font-size: 25px;

      }

    }

  </style>

</head>


<body>


  <!-- ==========================================
       NAVBAR
  ========================================== -->

  <nav class="navbar">

    <div class="logo">
      Home Appliances Rental
    </div>


    <div class="nav-links">

      <a href="/">
        Home
      </a>


      <a href="/products">
        Products
      </a>


      <% if (user) { %>

        <a href="/requests">
          My Requests
        </a>

        <a href="/logout">
          Logout
        </a>

      <% } else { %>

        <a href="/login">
          Login
        </a>

        <a href="/register">
          Register
        </a>

      <% } %>

    </div>

  </nav>


  <!-- ==========================================
       PRODUCT DETAILS
  ========================================== -->

  <div class="product-details-container">


    <div class="product-details-card">


      <!-- ========================================
           PRODUCT IMAGE
      ========================================= -->

      <div>

        <img
          src="<%= product.image %>"
          alt="<%= product.name %>"
          class="product-details-image"
        >

      </div>


      <!-- ========================================
           PRODUCT INFORMATION
      ========================================= -->

      <div class="product-details-info">


        <!-- PRODUCT NAME -->

        <h1>

          <%= product.name %>

        </h1>


        <!-- CATEGORY -->

        <span class="category-badge">

          <%= product.category %>

        </span>


        <!-- PRICE -->

        <div class="product-details-price">

          ₹<%= product.price.toLocaleString("en-IN") %>

          <span class="per-month">
            / month
          </span>

        </div>


        <!-- DESCRIPTION -->

        <p class="product-description">

          Rent the
          <strong>
            <%= product.name %>
          </strong>

          for your home with flexible rental
          duration and secure online payment.

          Choose your rental period and complete
          your booking through our secure
          Razorpay payment system.

        </p>


        <!-- ======================================
             FEATURES
        ======================================= -->

        <div class="features-box">

          <h3>
            Rental Features
          </h3>


          <div class="feature">

            <span>✓</span>

            Flexible rental duration

          </div>


          <div class="feature">

            <span>✓</span>

            Secure online payment

          </div>


          <div class="feature">

            <span>✓</span>

            Rental tracking

          </div>


          <div class="feature">

            <span>✓</span>

            Start and end date tracking

          </div>

        </div>


        <!-- ======================================
             RENT / LOGIN
        ======================================= -->

        <% if (user) { %>

          <a
            href="/rent/<%= product.id %>"
            class="rent-button"
          >

            Rent Now

          </a>


          <p class="secure-note">

            🔒 Secure payment powered by Razorpay

          </p>


        <% } else { %>

          <a
            href="/login"
            class="login-button"
          >

            Login to Rent

          </a>


          <p class="secure-note">

            Login to start your rental

          </p>

        <% } %>


        <!-- BACK -->

        <a
          href="/products"
          class="back-link"
        >

          ← Back to Products

        </a>


      </div>


    </div>


  </div>


</body>

</html>