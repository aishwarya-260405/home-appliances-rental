<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    Rent <%= product.name %> - Home Appliances Rental
  </title>

  <link rel="stylesheet" href="/style.css" />

  <style>

    .rent-container {
      max-width: 650px;
      margin: 50px auto;
      background: white;
      padding: 35px;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
    }

    .rent-container h1 {
      text-align: center;
      color: #1e3a8a;
      margin-bottom: 25px;
    }

    .rent-product {
      text-align: center;
      margin-bottom: 30px;
    }

    .rent-product img {
      width: 220px;
      height: 180px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 15px;
    }

    .rent-product h2 {
      color: #1e3a8a;
      margin-bottom: 8px;
    }

    .rent-price {
      font-size: 20px;
      font-weight: bold;
      color: #2563eb;
    }

    .rental-form {
      margin-top: 25px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .rental-form label {
      display: block;
      font-weight: bold;
      margin-bottom: 8px;
      color: #374151;
    }

    .rental-form select,
    .rental-form input[type="date"] {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
      box-sizing: border-box;
      background: white;
    }

    .rental-form select:focus,
    .rental-form input[type="date"]:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.10);
    }

    .date-note {
      margin-top: 6px;
      color: #6b7280;
      font-size: 13px;
    }

    .end-date-box {
      background: #f8fafc;
      border: 1px solid #dbeafe;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 20px;
    }

    .end-date-box p {
      margin: 5px 0;
      color: #374151;
    }

    .end-date {
      font-weight: bold;
      color: #1e3a8a;
      font-size: 17px;
    }

    .total-box {
      background: #f1f5ff;
      padding: 18px;
      border-radius: 10px;
      margin-bottom: 20px;
      text-align: center;
    }

    .total-box p {
      margin: 7px 0;
      color: #374151;
    }

    .total-amount {
      font-size: 26px;
      font-weight: bold;
      color: #1e3a8a;
    }

    .payment-btn {
      width: 100%;
      padding: 14px;
      font-size: 17px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.2s ease;
    }

    .payment-btn:hover {
      background: #1d4ed8;
    }

    .secure-note {
      text-align: center;
      margin-top: 12px;
      color: #6b7280;
      font-size: 13px;
    }

    .back-link {
      display: block;
      text-align: center;
      margin-top: 18px;
      color: #2563eb;
      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 700px) {

      .rent-container {
        margin: 30px 15px;
        padding: 25px;
      }

    }

  </style>

</head>


<body>


  <!-- ==========================================
       NAVBAR
  ========================================== -->

  <nav class="navbar">

    <div class="logo">
      Home Appliances Rental
    </div>

    <div class="nav-links">

      <a href="/">
        Home
      </a>

      <a href="/products">
        Products
      </a>

      <a href="/requests">
        My Requests
      </a>

      <a href="/logout">
        Logout
      </a>

    </div>

  </nav>


  <!-- ==========================================
       RENTAL CONTAINER
  ========================================== -->

  <div class="rent-container">


    <h1>
      Rental Details
    </h1>


    <!-- ========================================
         PRODUCT
    ========================================= -->

    <div class="rent-product">

      <img
        src="<%= product.image %>"
        alt="<%= product.name %>"
      />

      <h2>
        <%= product.name %>
      </h2>

      <p>
        Category:
        <%= product.category %>
      </p>

      <p class="rent-price">

        ₹<%= product.price.toLocaleString("en-IN") %>
        / month

      </p>

    </div>


    <!-- ========================================
         RENTAL FORM
    ========================================= -->

    <form
  action="/agreement"
  method="POST"
  class="rental-form"
>


      <!-- PRODUCT ID -->

      <input
        type="hidden"
        name="product_id"
        value="<%= product.id %>"
      />


      <!-- ======================================
           START DATE
      ======================================= -->

      <div class="form-group">

        <label for="rental_start_date">

          Rental Start Date

        </label>

        <input
          type="date"
          id="rental_start_date"
          name="rental_start_date"
          required
        />

        <div class="date-note">

          Select the date on which you want
          your rental to begin.

        </div>

      </div>


      <!-- ======================================
           RENTAL DURATION
      ======================================= -->

      <div class="form-group">

        <label for="rental_months">

          Rental Duration

        </label>

        <select
          id="rental_months"
          name="rental_months"
          required
        >

          <option value="1">
            1 Month
          </option>

          <option value="2">
            2 Months
          </option>

          <option value="3">
            3 Months
          </option>

          <option value="4">
            4 Months
          </option>

          <option value="5">
            5 Months
          </option>

          <option value="6">
            6 Months
          </option>

          <option value="7">
            7 Months
          </option>

          <option value="8">
            8 Months
          </option>

          <option value="9">
            9 Months
          </option>

          <option value="10">
            10 Months
          </option>

          <option value="11">
            11 Months
          </option>

          <option value="12">
            12 Months
          </option>

        </select>

      </div>


      <!-- ======================================
           END DATE PREVIEW
      ======================================= -->

      <div class="end-date-box">

        <p>
          Expected Rental End Date:
        </p>

        <p
          class="end-date"
          id="endDate"
        >
          -
        </p>

      </div>


      <!-- ======================================
           TOTAL
      ======================================= -->

      <div class="total-box">

        <p>

          Monthly Price:

          ₹<span id="monthlyPrice">

            <%= product.price.toLocaleString("en-IN") %>

          </span>

        </p>


        <p>

          Rental Duration:

          <span id="selectedMonths">
            1
          </span>

          Month

        </p>


        <p class="total-amount">

          Total:

          ₹<span id="totalAmount">

            <%= product.price.toLocaleString("en-IN") %>

          </span>

        </p>

      </div>


      <!-- ======================================
           PAYMENT BUTTON
      ======================================= -->

      <button
        type="submit"
        class="payment-btn"
      >

        Proceed to Secure Payment

      </button>


      <p class="secure-note">

        🔒 Secure payment powered by Razorpay

      </p>


    </form>


    <!-- ========================================
         BACK
    ========================================= -->

    <a
      href="/products/<%= product.id %>"
      class="back-link"
    >

      ← Back to Product Details

    </a>


  </div>


  <!-- ==========================================
       JAVASCRIPT
  ========================================== -->

  <script>

    const rentalMonths =
      document.getElementById(
        "rental_months"
      );


    const startDate =
      document.getElementById(
        "rental_start_date"
      );


    const selectedMonths =
      document.getElementById(
        "selectedMonths"
      );


    const totalAmount =
      document.getElementById(
        "totalAmount"
      );


    const endDate =
      document.getElementById(
        "endDate"
      );


    const monthlyPrice =
      Number(
        "<%= product.price %>"
      );


    // ==========================================
    // TODAY'S DATE
    // ==========================================

    const today =
      new Date();


    const year =
      today.getFullYear();


    const month =
      String(
        today.getMonth() + 1
      ).padStart(2, "0");


    const day =
      String(
        today.getDate()
      ).padStart(2, "0");


    const todayString =
      `${year}-${month}-${day}`;


    startDate.min =
      todayString;


    // Default start date = today

    startDate.value =
      todayString;


    // ==========================================
    // FORMAT DATE
    // ==========================================

    function formatDate(date) {

      return date.toLocaleDateString(
        "en-IN",
        {
          day: "2-digit",
          month: "short",
          year: "numeric"
        }
      );

    }


    // ==========================================
    // UPDATE RENTAL DETAILS
    // ==========================================

    function updateRentalDetails() {

      const months =
        Number(
          rentalMonths.value
        );


      const total =
        monthlyPrice * months;


      // Update duration

      selectedMonths.textContent =
        months;


      // Update total

      totalAmount.textContent =
        total.toLocaleString(
          "en-IN"
        );


      // ========================================
      // CALCULATE END DATE
      // ========================================

      if (startDate.value) {

        const start =
          new Date(
            startDate.value + "T00:00:00"
          );


        const end =
          new Date(start);


        end.setMonth(
          end.getMonth() + months
        );


        endDate.textContent =
          formatDate(end);

      } else {

        endDate.textContent =
          "-";

      }

    }


    // ==========================================
    // EVENTS
    // ==========================================

    rentalMonths.addEventListener(
      "change",
      updateRentalDetails
    );


    startDate.addEventListener(
      "change",
      updateRentalDetails
    );


    // Initial calculation

    updateRentalDetails();

  </script>


</body>

</html>